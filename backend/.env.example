# Backend Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Demo mode - seeds the demo hotel/dishes and tables
DEMO_MODE=true

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL used in QR codes.
# DEV: leave unset so the backend auto-detects your machine's LAN IP, letting
# phones on the same WiFi scan the QR. Set to your deployed URL in production,
# e.g. FRONTEND_URL=https://your-app.example.com
#FRONTEND_URL=http://localhost:3000

# Database Configuration - the app always uses the local SQLite file (Tabble.db)
DATABASE_TYPE=sqlite

# Super Admin Password for /adminofthetabble access
ADMIN_PASSWORD=your-admin-password-here

# Firebase Admin SDK (for Google Sign-In verification of chef/customer users)
# Option 1: Direct JSON (for local development)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tabble-v4",...}
# Option 2: Base64 encoded JSON (for production)
# FIREBASE_SERVICE_ACCOUNT_BASE64=<your-base64-encoded-json>
FIREBASE_PROJECT_ID=tabble-v4

# Allowed CORS origins (comma-separated) - frontend dev origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000