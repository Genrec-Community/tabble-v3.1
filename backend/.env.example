# Backend Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Security
SECRET_KEY=your-secret-key-here

# SMS API for OTP (optional - leave as-is for demo mode)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Demo mode - Set to true to use fixed OTP 11111 and skip SMS
DEMO_MODE=true

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL - Update with your deployed Vercel URL
FRONTEND_URL=http://localhost:3000

# Database Configuration - SQLite for both local and production
DATABASE_TYPE=sqlite

# Super Admin Password for /adminofthetabble access
ADMIN_PASSWORD=your-admin-password-here

# Allowed CORS origins (comma-separated) - frontend dev origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
