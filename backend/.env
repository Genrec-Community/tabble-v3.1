# Demo mode — uses fixed OTP 11111 and skips SMS (set to false in production)
DEMO_MODE=true

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL used in QR codes.
# DEV: leave unset so the backend auto-detects your machine's LAN IP, letting
# phones on the same WiFi scan the QR. Set to your deployed URL in production,
# e.g. FRONTEND_URL=https://your-app.example.com
#FRONTEND_URL=http://localhost:3000

# Database Configuration — the app always uses the local SQLite file (Tabble.db)
DATABASE_TYPE=sqlite

# Super Admin Password
ADMIN_PASSWORD=adminoftabble

# Firebase Admin SDK Configuration (for Google Sign-In verification)
# Option 1: Direct JSON (for local development)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tabble-v4",...}

# Option 2: Base64 encoded JSON (for production/Render)
# FIREBASE_SERVICE_ACCOUNT_BASE64=<your-base64-encoded-json>

# Firebase Project ID
FIREBASE_PROJECT_ID=tabble-v4

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.150.138.137:3000